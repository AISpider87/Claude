# Copia questo file in ".env" e mettici le tue chiavi vere.
# Le chiavi si trovano su https://dashboard.stripe.com/apikeys
# ATTENZIONE: il file .env non va mai messo su GitHub.

# Chiave segreta. Inizia con sk_test_ in prova, sk_live_ quando vendi davvero.
STRIPE_CHIAVE_SEGRETA=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Segreto del webhook (lo da' "stripe listen" oppure la dashboard). Facoltativo.
STRIPE_WEBHOOK_SEGRETO=whsec_xxxxxxxxxxxxxxxxxxxxx

# Indirizzi da cui il negozio puo' chiamare il server, separati da virgola.
# In locale con doppio clic sul file, il browser manda origine "null": e' gia' ammessa.
ORIGINI_AMMESSE=http://localhost:8000,https://tuo-utente.github.io

# Indirizzo del negozio usato se la pagina non ne dichiara uno valido.
SITO=http://localhost:8000/index.html

# Porta del server
PORTA=4242
