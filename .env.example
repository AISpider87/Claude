# Copy to .env.local for local development. Never commit real values.

# Supabase project (Settings > API). The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the app, used in auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used by the cron job (M5) and admin imports. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
# Sender shown in league emails (a domain verified on Resend, or the onboarding sender for tests).
EMAIL_FROM=SuperLega <onboarding@resend.dev>

# Automatic quotations sync (M5). Leave empty to rely on the admin's manual upload.
# Set only after verifying the download endpoint and the site's terms (docs/SYNC.md).
QUOTATIONS_SOURCE_URL=
QUOTATIONS_SOURCE_COOKIE=

# Availability/lineup feed (M15). Empty = feed off: only the admin's manual
# statuses, which keep working exactly as before. Never commit a real key.
#
# Which provider to use: "bsd" (default when BSD_API_KEY is set) or
# "api-football". API-Football's FREE plan does not cover the current season
# ("Free plans do not have access to this season, try from 2022 to 2024"), so
# the league runs on Big Balls Sports Data — see docs/SYNC.md.
AVAILABILITY_PROVIDER=bsd

# Big Balls Sports Data (bigballsdata.com), free tier, ~1000 requests/day.
BSD_API_KEY=
# Optional: another base URL (no trailing slash).
BSD_BASE_URL=https://api.bigballsdata.com
# Optional: how the provider names Serie A — the slug, or its numeric id.
BSD_LEAGUE=serie-a

# API-Football (api-sports.io), free plan: 100 requests/day, past seasons only.
API_FOOTBALL_KEY=
# Optional: forces the season (2026/27 -> 2026). Leave empty to derive it from the date.
API_FOOTBALL_SEASON=
