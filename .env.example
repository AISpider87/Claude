# Copy to .env.local for local development. Never commit real values.

# Supabase project (Settings > API). The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the app, used in auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used by the cron job (M5) and admin imports. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
